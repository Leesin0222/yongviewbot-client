{
  "name": "yongviewbot-client",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:all": "vite build && electron-builder --win --mac",
    "copy-jar": "node scripts/copy-jar.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.yongviewbot.client",
    "productName": "Yongviewbot Client",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "extraResources": [{ "from": "resources/yongviewbot.jar", "to": "yongviewbot.jar" }],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" }
  }
}
